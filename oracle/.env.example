# Copy to .env. .env is gitignored.

# Anvil account 0 -- the well-known public dev key, never use it on a real network.
# Must match the Registry's scoreOracle; deploy_local.py sets that to account 0.
ORACLE_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Optional overrides. RPC defaults to the rpcUrl in deployments/local.json.
# RPC_URL=http://127.0.0.1:8545
# SCORE_URL=http://127.0.0.1:8000
# POLL_INTERVAL=1.0
# VALUE_DECIMALS=6
